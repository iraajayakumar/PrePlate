spring.application.name=preplate-backend
server.port=8080
spring.datasource.url=jdbc:mysql://localhost:3306/preplate_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:}
spring.jpa.hibernate.ddl-auto=none
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.jdbc.time_zone=UTC
preplate.timezone=Asia/Kolkata
preplate.dev.simulated-now=
preplate.notifications.reminder-lead-minutes=30
preplate.forecast.enabled=true
preplate.forecast.base-url=http://127.0.0.1:8000
preplate.forecast.timeout-ms=5000
preplate.forecast.safety-buffer=0.05
preplate.forecast.item-unit=servings
preplate.seed.enabled=true
preplate.seed.student-count=60
preplate.cors.allowed-origins=http://localhost:5173
